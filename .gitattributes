# Normalize line endings: LF in the repo, native on checkout where it matters.
* text=auto eol=lf

# Windows scripts must stay CRLF
*.cmd text eol=crlf
*.bat text eol=crlf

# Maven wrapper script must stay LF (it runs under sh)
mvnw text eol=lf

# Binary-ish / generated
*.jar binary
*.png binary
*.jpg binary
